# GigLink Mobile — Environment Variables

# API base URL (non-sensitive, exposed to client via EXPO_PUBLIC_*)
# Android emulator: use http://10.0.2.2:7000/api to reach host machine localhost
# iOS simulator: http://localhost:7000/api
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.10:7000/api
EXPO_PUBLIC_API_URL=http://localhost:7000/api

# Google OAuth web/server client ID (non-sensitive, exposed to client via EXPO_PUBLIC_*).
# Required for Google sign-in: it is used as the audience of the ID token the backend verifies.
# Must match the backend GOOGLE_WEB_CLIENT_ID.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
