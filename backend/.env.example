PORT=7000
MONGO_URI=mongodb://127.0.0.1:27017/gig_marketplace
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Google OAuth web/server client ID used to verify Google ID tokens (audience).
# Client IDs are not secrets. The matching webClientId is also required in the mobile app.
GOOGLE_WEB_CLIENT_ID=

# Optional: Expo push service access token (https://expo.dev/settings/access-tokens)
# If omitted, push delivery uses the credentials embedded in the app's push tokens.
EXPO_ACCESS_TOKEN=

# Firebase Admin (FCM push delivery). Uses Google Application Default
# Credentials (ADC). Set to the absolute path of a service-account JSON, or a
# Workload Identity Federation external-account JSON. Credentials are loaded
# ONLY from this env var; leave empty to skip FCM delivery (Expo still works).
# Never commit the credential file; keep it as a Render env/secret.
GOOGLE_APPLICATION_CREDENTIALS=

# TextBee SMS configuration
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Cloudinary image upload (profile photo / company logo)
# The API secret stays server-side and is used ONLY to compute signed upload
# authorizations. It must never be placed in any mobile environment variable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=