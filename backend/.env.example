PORT=7000
MONGO_URI=mongodb://127.0.0.1:27017/gig_marketplace
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Google OAuth web/server client ID used to verify Google ID tokens (audience).
# Client IDs are not secrets. The matching webClientId is also required in the mobile app.
GOOGLE_WEB_CLIENT_ID=

# Optional: Expo push service access token (https://expo.dev/settings/access-tokens)
# If omitted, push delivery uses the credentials embedded in the app's push tokens.
EXPO_ACCESS_TOKEN=