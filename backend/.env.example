PORT=7000
MONGO_URI=mongodb://127.0.0.1:27017/gig_marketplace
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Google OAuth web/server client ID used to verify Google ID tokens (audience).
# Client IDs are not secrets. The matching webClientId is also required in the mobile app.
GOOGLE_WEB_CLIENT_ID=

# Pushy push delivery (https://pushy.me/docs/api/send-notifications)
# Secret API key from the Pushy Dashboard (App Settings -> API Keys).
# Read ONLY from this server-side env var — never hardcoded, never shipped to
# the mobile app, never logged. Keep it as a Render secret.
PUSHY_API_KEY=

# TextBee SMS configuration
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Cloudinary image upload (profile photo / company logo)
# The API secret stays server-side and is used ONLY to compute signed upload
# authorizations. It must never be placed in any mobile environment variable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Support email shown on the Contact page (/contact). Optional — if unset the
# page directs users to in-app contact instead. Never hardcode an invented email.
SUPPORT_EMAIL=